<Window x:Class="OsuScoutNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:OsuScoutNew"
        Title="Scoutsu" Width="840" Height="560" MinWidth="720" MinHeight="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <local:SecondsToClockConverter x:Key="Clock"/>
        <local:TagListConverter x:Key="TagList"/>

        <!-- A field's name above it (SEARCH, TAGS) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
        <!-- A filter's name and its current value (STARS ... 6★+) -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterValue" TargetType="TextBlock" BasedOn="{StaticResource FilterLabel}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseDown="Window_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="SCOUTSU" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="ENGINE" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <!-- Which client's library is shown. Each keeps its own library. -->
                        <Border x:Name="ClientSwitch" Margin="16,0,0,0" Background="{StaticResource FieldBrush}" CornerRadius="6" Padding="2"
                                VerticalAlignment="Center" ToolTip="Which osu! to show maps from. Each keeps its own library.">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="StableButton" Content="STABLE" GroupName="Client" Style="{StaticResource SegmentButton}" Checked="ClientButton_Checked"/>
                                <RadioButton x:Name="LazerButton" Content="LAZER" GroupName="Client" Style="{StaticResource SegmentButton}" Margin="2,0,0,0" Checked="ClientButton_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}" IsChecked="True" Margin="0,0,10,0"
                                      Click="PinButton_Click" ToolTip="Keep on top of the game"/>
                        <Button Style="{StaticResource ChromeButton}" Foreground="{StaticResource DonateBrush}" Width="65" FontSize="10" Margin="0,0,10,0"
                                Click="DonateButton_Click" ToolTip="Support the developer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 12 21 L 3.2 12.4 A 5.5 5.5 0 0 1 11 4.6 L 12 5.7 L 13 4.6 A 5.5 5.5 0 0 1 20.8 12.4 Z" Fill="{StaticResource DonateBrush}"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="DONATE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FolderButton" Style="{StaticResource ChromeButton}" Width="45" FontSize="10" Margin="0,0,10,0"
                                Click="ChangeFolderButton_Click" ToolTip="Change Songs Folder">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 3 7 A 2 2 0 0 1 5 5 L 9 5 L 11 7 L 19 7 A 2 2 0 0 1 21 9 L 21 17 A 2 2 0 0 1 19 19 L 5 19 A 2 2 0 0 1 3 17 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="DIR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="—" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click" Margin="0,0,4,0" ToolTip="Minimise"/>
                        <Button Content="✕" Style="{StaticResource ChromeButton}" Foreground="{StaticResource DangerBrush}" Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- Filters -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SearchBox" Height="30" TextChanged="SearchInput_TextChanged"
                                     ToolTip="Artist, title, difficulty or mapper"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="TAGS (Use '-' to exclude and ',' to separate tags)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TagSearchBox" Height="30" IsEditable="True"
                                      TextBoxBase.TextChanged="SearchInput_TextChanged"
                                      SelectionChanged="TagSearchBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Each filter's value text is filled in by UpdateFilterLabels(). A handle parked at
                         the end of its track means "no limit", shown as "ANY", "UP TO x" or "x+". -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <DockPanel>
                                <Button x:Name="StarResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=StarSlider}" Click="ResetSlider_Click" ToolTip="Clear star filter"/>
                                <TextBlock x:Name="StarValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="STARS" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="StarSlider" Minimum="0" Maximum="10" MinRange="0.5" LowerValue="0" UpperValue="10" TickFrequency="0.5" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <DockPanel>
                                <Button x:Name="BpmResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=BpmSlider}" Click="ResetSlider_Click" ToolTip="Clear BPM filter"/>
                                <TextBlock x:Name="BpmValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="BPM" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="BpmSlider" Minimum="0" Maximum="300" MinRange="10" LowerValue="0" UpperValue="300" TickFrequency="10" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <DockPanel>
                                <Button x:Name="LengthResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=LengthSlider}" Click="ResetSlider_Click" ToolTip="Clear length filter"/>
                                <TextBlock x:Name="LengthValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="LENGTH" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <!-- Starts at 0 and keeps the handles a minute apart, so dragging the right handle all the
                                 way left lands on "UP TO 1 MIN" (short / cut-ver maps) -->
                            <mah:RangeSlider x:Name="LengthSlider" Minimum="0" Maximum="20" MinRange="1" LowerValue="0" UpperValue="20" TickFrequency="1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="Tip: Shift-click column headers to sort by several. Right-click one to choose columns."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontStyle="Italic" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="MoreFiltersToggle" Style="{StaticResource DisclosureToggle}" Content="MORE FILTERS (CS, AR, OD, HP)"
                                      Checked="MoreFiltersToggle_Changed" Unchecked="MoreFiltersToggle_Changed"/>
                        <TextBlock x:Name="MoreFiltersSummary" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid x:Name="MoreFiltersPanel" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0" ToolTip="Circle size">
                            <DockPanel>
                                <Button x:Name="CsResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=CsSlider}" Click="ResetSlider_Click" ToolTip="Clear CS filter"/>
                                <TextBlock x:Name="CsValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="CS" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="CsSlider" Minimum="0" Maximum="10" MinRange="0.1" LowerValue="0" UpperValue="10" TickFrequency="0.1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,4,0" ToolTip="Approach rate">
                            <DockPanel>
                                <Button x:Name="ArResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=ArSlider}" Click="ResetSlider_Click" ToolTip="Clear AR filter"/>
                                <TextBlock x:Name="ArValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="AR" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="ArSlider" Minimum="0" Maximum="10" MinRange="0.1" LowerValue="0" UpperValue="10" TickFrequency="0.1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="4,0,4,0" ToolTip="Overall difficulty (accuracy)">
                            <DockPanel>
                                <Button x:Name="OdResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=OdSlider}" Click="ResetSlider_Click" ToolTip="Clear OD filter"/>
                                <TextBlock x:Name="OdValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="OD" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="OdSlider" Minimum="0" Maximum="10" MinRange="0.1" LowerValue="0" UpperValue="10" TickFrequency="0.1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="8,0,0,0" ToolTip="HP drain">
                            <DockPanel>
                                <Button x:Name="HpResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                        Tag="{Binding ElementName=HpSlider}" Click="ResetSlider_Click" ToolTip="Clear HP filter"/>
                                <TextBlock x:Name="HpValueText" Style="{StaticResource FilterValue}"/>
                                <TextBlock Text="HP" Style="{StaticResource FilterLabel}"/>
                            </DockPanel>
                            <mah:RangeSlider x:Name="HpSlider" Minimum="0" Maximum="10" MinRange="0.1" LowerValue="0" UpperValue="10" TickFrequency="0.1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- The map list -->
                <Border Grid.Row="2" Background="{StaticResource ListBrush}" CornerRadius="8" BorderBrush="{StaticResource ListBorderBrush}" BorderThickness="1">
                    <Grid>
                        <DataGrid x:Name="BeatmapGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseDoubleClick="BeatmapGrid_MouseDoubleClick"
                                  CanUserSortColumns="True" Sorting="BeatmapGrid_Sorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ARTIST" Binding="{Binding Artist}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="DIFF" Binding="{Binding Version}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="MAPPER" Binding="{Binding Mapper}" Width="0.75*" Visibility="Collapsed">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="★" Binding="{Binding StarRating, StringFormat={}{0:F2}}" Width="0.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="BPM" Binding="{Binding BPM}" Width="50" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="LENGTH" Binding="{Binding LengthSeconds, Converter={StaticResource Clock}}" SortMemberPath="LengthSeconds"
                                                    Width="64" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="CS" Binding="{Binding CS, StringFormat={}{0:0.#}}" Width="42" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="AR" Binding="{Binding AR, StringFormat={}{0:0.#}}" Width="42" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="OD" Binding="{Binding OD, StringFormat={}{0:0.#}}" Width="42" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>
                                <DataGridTextColumn Header="HP" Binding="{Binding HP, StringFormat={}{0:0.#}}" Width="42" Visibility="Collapsed" ElementStyle="{StaticResource NumberCell}"/>

                                <!-- Every tag, wrapped between tags. Tags the TAGS filter asked for are pink. -->
                                <DataGridTemplateColumn Header="AI TAGS" Width="2*" SortMemberPath="Tags">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ItemsControl Focusable="False" IsHitTestVisible="False">
                                                    <ItemsControl.ItemsSource>
                                                        <MultiBinding Converter="{StaticResource TagList}">
                                                            <Binding Path="Tags"/>
                                                            <Binding Path="HighlightTerms" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </ItemsControl.ItemsSource>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="tag" Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="16"/>
                                                                <TextBlock Text="{Binding Separator}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="16"/>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                    <Setter TargetName="tag" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                    <Setter TargetName="tag" Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- The model wasn't confident about any tag for this map. -->
                                                <TextBlock x:Name="untagged" Text="no confident tags" FontStyle="Italic"
                                                           Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tags}" Value="">
                                                    <Setter TargetName="untagged" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Shown instead of an empty list -->
                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="Collapsed"
                                    IsHitTestVisible="False" Margin="0,30,0,0">
                            <TextBlock x:Name="EmptyTitle" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmptyBody" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions & Hotkey Notice -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="HotkeyPanel" Orientation="Horizontal" Visibility="Visible">
                            <Border Background="{StaticResource FieldBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="ALT + S" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="TO TOGGLE OVERLAY IN-GAME" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <ProgressBar x:Name="ScanProgressBar" Width="150" Minimum="0" Maximum="100" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScanProgressText" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="MapCountText" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="PlayButton" Content="Copy &amp; Switch to osu!" Width="180" Height="34"
                                Click="PlayButton_Click" Style="{StaticResource PrimaryButton}"
                                ToolTip="Copies the map's search (the beatmap ID on osu!lazer), then switches to osu!. Paste it into song select."/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Resize from the corner. The window has no frame of its own to grab. -->
            <Thumb x:Name="ResizeThumb" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                   Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Canvas Width="14" Height="14" Background="Transparent">
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="#4DFFFFFF"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="10" Width="2" Height="2" Fill="#4DFFFFFF"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="6" Width="2" Height="2" Fill="#4DFFFFFF"/>
                            <Ellipse Canvas.Left="2" Canvas.Top="10" Width="2" Height="2" Fill="#4DFFFFFF"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="6" Width="2" Height="2" Fill="#4DFFFFFF"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="2" Width="2" Height="2" Fill="#4DFFFFFF"/>
                        </Canvas>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
