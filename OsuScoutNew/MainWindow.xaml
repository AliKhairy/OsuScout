<Window x:Class="OsuScoutNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:OsuScoutNew"
        Title="Scoutsu" Width="1100" Height="680" MinWidth="780" MinHeight="460"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:SecondsToClockConverter x:Key="Clock"/>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Window}" BorderBrush="{StaticResource Brush.Separator}"
                BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Library:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Brush.TextDim}"/>
                    <ComboBox x:Name="ClientCombo" Width="110" SelectionChanged="ClientCombo_SelectionChanged"
                              ToolTip="Which osu! client's maps to show. Each keeps its own library.">
                        <ComboBoxItem Content="osu!stable"/>
                        <ComboBoxItem Content="osu!lazer"/>
                    </ComboBox>
                    <Button x:Name="FolderButton" Content="Folder…" Margin="6,0,0,0" Click="ChangeFolderButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Window}" BorderBrush="{StaticResource Brush.Separator}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,16,0">
                    <ProgressBar x:Name="ScanProgressBar" Width="160" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScanProgressText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LibraryStatusText" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Panel}" Padding="10,8">
            <DockPanel>
                <Button x:Name="PlayButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Copy &amp; switch to osu!"
                        Click="PlayButton_Click"
                        ToolTip="Copies the map's beatmap ID (lazer) or artist, title and difficulty (stable), then switches to osu!. Paste it into song select."/>
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Text="Select a map, or double-click it, to find it in osu!'s song select."/>
            </DockPanel>
        </Border>

        <!-- Filters | map list -->
        <Grid Background="{StaticResource Brush.Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Panel}">
                <StackPanel Margin="12,12,6,12">
                    <TextBlock Text="Search" Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchInput_TextChanged"
                             ToolTip="Matches artist, title or difficulty name"/>
                    <TextBlock Text="Artist, title or difficulty" Style="{StaticResource Hint}" Margin="0,3,0,14"/>

                    <TextBlock Text="Tags" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="TagSearchBox" IsEditable="True"
                              TextBoxBase.TextChanged="SearchInput_TextChanged"
                              SelectionChanged="TagSearchBox_SelectionChanged"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,16"
                               Text="Separate tags with commas. Put - in front of a tag to exclude it, e.g. aim, -streams"/>

                    <!-- Each filter's value text is filled in by UpdateFilterLabels(). A handle parked at
                         the end of its track means "no limit", shown as "ANY", "UP TO x" or "x+". -->
                    <DockPanel Margin="0,0,0,2">
                        <Button x:Name="StarResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                Tag="{Binding ElementName=StarSlider}" Click="ResetSlider_Click" ToolTip="Clear star filter"/>
                        <TextBlock x:Name="StarValueText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="Stars" Style="{StaticResource SectionHeader}" Margin="0"/>
                    </DockPanel>
                    <mah:RangeSlider x:Name="StarSlider" Minimum="0" Maximum="10" MinRange="0.5" LowerValue="0" UpperValue="10" TickFrequency="0.5" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,2">
                        <Button x:Name="BpmResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                Tag="{Binding ElementName=BpmSlider}" Click="ResetSlider_Click" ToolTip="Clear BPM filter"/>
                        <TextBlock x:Name="BpmValueText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="BPM" Style="{StaticResource SectionHeader}" Margin="0"/>
                    </DockPanel>
                    <mah:RangeSlider x:Name="BpmSlider" Minimum="0" Maximum="300" MinRange="10" LowerValue="0" UpperValue="300" TickFrequency="10" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,2">
                        <Button x:Name="LengthResetButton" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ResetButton}"
                                Tag="{Binding ElementName=LengthSlider}" Click="ResetSlider_Click" ToolTip="Clear length filter"/>
                        <TextBlock x:Name="LengthValueText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="Length" Style="{StaticResource SectionHeader}" Margin="0"/>
                    </DockPanel>
                    <!-- Starts at 0 and keeps the handles a minute apart, so dragging the right handle all the
                         way left lands on "UP TO 1 MIN" (short / cut-ver maps) -->
                    <mah:RangeSlider x:Name="LengthSlider" Minimum="0" Maximum="20" MinRange="1" LowerValue="0" UpperValue="20" TickFrequency="1" IsSnapToTickEnabled="True" LowerValueChanged="Slider_ValueChanged" UpperValueChanged="Slider_ValueChanged" Margin="0,0,0,18"/>

                    <TextBlock Style="{StaticResource Hint}"
                               Text="Click a column header to sort. Shift-click to sort by more than one column."/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <DataGrid x:Name="BeatmapGrid" Grid.Column="2" Margin="0,12,12,0" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="BeatmapGrid_MouseDoubleClick" SelectionChanged="BeatmapGrid_SelectionChanged"
                      CanUserSortColumns="True" Sorting="BeatmapGrid_Sorting">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*"/>
                    <DataGridTextColumn Header="Difficulty" Binding="{Binding Version}" Width="*"/>
                    <DataGridTextColumn Header="★" Binding="{Binding StarRating, StringFormat={}{0:F2}}" Width="52">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="BPM" Binding="{Binding BPM}" Width="48" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn Header="Length" Binding="{Binding LengthSeconds, Converter={StaticResource Clock}}"
                                        SortMemberPath="LengthSeconds" Width="56" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTemplateColumn Header="Tags" Width="1.6*" SortMemberPath="Tags">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Brush.TextDim}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Tags}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
