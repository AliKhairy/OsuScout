<Window x:Class="OsuScoutNew.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        MinWidth="400" MaxWidth="620" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- The same panel as the main window, so a message never pops up as a white Windows box. -->
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
            Margin="10" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="18"/>
            </ScrollViewer>
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
    </Border>
</Window>
